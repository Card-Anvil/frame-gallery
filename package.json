{
  "name": "frame-gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The list of frame repositories Card Anvil's Frame Gallery shows.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "aggregate": "node --experimental-strip-types scripts/aggregate.ts",
    "test": "node --experimental-strip-types --test scripts/*.test.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:ci": "prettier --check ."
  },
  "dependencies": {
    "@cardanvil/frame-kit": "^0.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@cardanvil/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "volta": {
    "node": "24.16.0"
  }
}
